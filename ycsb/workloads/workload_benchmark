# zal edit workload to test io on linux raid, used together with `properties/raid.properties`

# data size: 2GB = 16K * 1048576
# BUG we are not sure how to control data size.!! should insert and update all be counted in?
recordcount=1048576

operationcount=1000000

workload=zal.test.io.ssd

readallfields=true

requestdistribution=zipfian

# proportion control
readproportion=0.95
updateproportion=0.05
insertproportion=0

# zal add to control key&value length
## zeropadding should - 4 because there is a prefix "user" in every key
# key_len: 24 Bytes
zeropadding=20

## in order to have value length==1000, valuelength = (fieldlength + 14) * fieldcount
# BUG yet to figer out what `14` is
# value_len: 1000 Bytes
fieldlength=2010
fieldcount=1